DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Enkripsi field (WAJIB di produksi — generate dgn Fernet.generate_key())
DJANGO_FIELD_ENCRYPTION_KEY=
# Sentry (opsional)
